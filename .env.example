# Settings for the enquiry form mailer (public/api/contact.php). Copy the values to the SERVER only —
# never commit real values. On Hostinger they go in a private config file outside public_html:
#   docs/HOSTINGER-SMTP-SETUP.md  (step-by-step, with the exact file and format)
# The handler reads real environment variables first, then that file.

# --- Required ---
# Zoho Mail SMTP — copy the exact host from Zoho Mail → Settings → Mail Accounts → Server Configuration Details.
# India data centre: smtppro.zoho.in (paid organisation plans) or smtp.zoho.in (free plan); .com/.eu for other regions.
SMTP_HOST=smtppro.zoho.in
# 465 = SSL/TLS (recommended) · 587 = STARTTLS
SMTP_PORT=465
# The Zoho mailbox that sends the enquiry email (must be the mailbox you log in with)
SMTP_USER=info@ayurvedavaidya.com
# Zoho APP-SPECIFIC password (Zoho Mail → My Account → Security → App Passwords), not the login password
SMTP_PASS=
# Where enquiries are delivered
MAIL_TO=info@ayurvedavaidya.com
# The From address — must be SMTP_USER or a verified alias of it in Zoho
MAIL_FROM=info@ayurvedavaidya.com

# --- Optional (defaults shown) ---
# ssl | tls — empty = decided from the port (465 → ssl, otherwise STARTTLS)
SMTP_SECURE=
SITE_NAME=AyurvedaVaidya
SITE_URL=https://ayurvedavaidya.com
# Extra allowed origins, comma separated (e.g. a Hostinger preview domain). The live domain, www and localhost are always allowed.
ALLOWED_ORIGINS=
TIMEZONE=Asia/Kolkata
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=600
MIN_FILL_SECONDS=3
