{
  "name": "ayurvedavaidya",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "node scripts/serve.mjs",
    "images": "node scripts/build-images.mjs",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "test": "npm run test:unit && npm run test:php",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "test:php": "node scripts/run-php.mjs tests/php/run.php",
    "test:e2e": "playwright test",
    "audit:seo": "node scripts/audit-seo.mjs",
    "audit:lighthouse": "node scripts/lighthouse.mjs",
    "verify": "npm run typecheck && npm run build && npm test && npm run audit:seo && npm run test:e2e",
    "package": "node scripts/package-upload.mjs",
    "check:live": "node scripts/check-live.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.3",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "1.2.2",
    "lighthouse": "13.5.0",
    "node-html-parser": "9.0.4",
    "sharp": "0.35.5"
  }
}
